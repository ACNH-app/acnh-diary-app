{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/db/**/*.ts",
    "src/data/**/*.ts",
    "src/screens/**/*.tsx",
    "src/components/ScreenHeader.tsx",
    "src/screens/**/*.ts",
    "src/types/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
